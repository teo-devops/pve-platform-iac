{{ ansible_managed | comment }}
global:
  scrape_interval: {{ monitoring_scrape_interval }}

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      # localhost dentro del contenedor de Prometheus, no del host: el puerto es
      # el 9090 interno, no monitoring_prometheus_port.
      - targets: ['localhost:9090']

{% for job in monitoring_scrape_jobs %}
  - job_name: '{{ job.job_name }}'
    static_configs:
      - targets: {{ job.targets | to_json }}
{% endfor %}
